# Task Board Mobile App - Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (include /api at the end)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# Backend Socket URL (no /api at the end)
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:4000

# Android Emulator: 10.0.2.2
# iOS Simulator: localhost
# Physical Device: your computer's LAN IP (e.g. 192.168.1.x)
