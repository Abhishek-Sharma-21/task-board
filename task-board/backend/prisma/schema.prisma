datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String             @id @default(uuid())
  name                 String
  email                String             @unique
  passwordHash         String
  avatarUrl            String             @default("")
  refreshTokenJtis     String[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  workspacesOwned      Workspace[]        @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  projectMemberships   ProjectMember[]
  comments             Comment[]
  chatMessages         TaskChatMessage[]
  activities           Activity[]
  notificationsReceived Notification[]    @relation("RecipientUser")
  notificationsSent     Notification[]    @relation("SenderUser")
  invitesSent          WorkspaceInvite[]  @relation("InviteSender")
  assignedTasks        TaskAssignee[]
}

model Workspace {
  id                    String            @id @default(uuid())
  name                  String
  ownerId               String
  activityRetentionDays Int               @default(30)
  owner                 User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members               WorkspaceMember[]
  projects              Project[]
  activities            Activity[]
  invites               WorkspaceInvite[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    // "owner", "admin", "member"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  token       String    @unique
  role        String    @default("member")
  invitedById String
  invitedBy   User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([workspaceId, email])
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   // "head", "member"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Project {
  id          String           @id @default(uuid())
  name        String
  description String           @default("")
  status      String           @default("Active") // "Planning", "Active", "Completed", "Archived"
  healthStatus String          @default("On Track") // "On Track", "At Risk", "Delayed", "Completed", "Archived"
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   String
  boards      Board[]
  members     ProjectMember[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Board {
  id          String        @id @default(uuid())
  name        String
  description String        @default("")
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   String
  columns     BoardColumn[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model BoardColumn {
  id        String   @id @default(uuid())
  name      String
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  position  Int
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id              String          @id @default(uuid())
  title           String
  description     String          @default("")
  projectId       String
  boardId         String
  columnId        String
  column          BoardColumn     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  position        Int
  priority        String          @default("Medium") // "Low", "Medium", "High", "Urgent"
  dependsOnTaskId String?
  createdBy       String
  labels          String[]
  dueDate         DateTime?
  version         Int             @default(0)
  isArchived      Boolean         @default(false)
  comments        Comment[]
  chatMessages    TaskChatMessage[]
  checklists      ChecklistItem[]
  assignees       TaskAssignee[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([boardId])
  @@index([columnId])
  @@index([projectId])
  @@index([dependsOnTaskId])
}

model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model ChecklistItem {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("RecipientUser", fields: [userId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("SenderUser", fields: [senderId], references: [id], onDelete: Cascade)
  type      String   // "task_assigned", "task_moved", "comment_added", "project_added"
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Activity {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  boardId     String?
  taskId      String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  description String
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model TaskChatMessage {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  isEdited  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([userId])
}

